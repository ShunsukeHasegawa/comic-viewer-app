<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 以下の full-backup-content（#15）。
     allowBackup="false" なので本来は使われないが、将来 allowBackup を戻されたときの
     保険として data_extraction_rules.xml と同じく全部外す（理由はそちらを参照）。 -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
